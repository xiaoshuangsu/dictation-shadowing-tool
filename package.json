{
  "name": "dictation-shadowing-tool",
  "version": "23.0.0",
  "homepage": "https://xiaoshuangsu.github.io/dictation-shadowing-tool/",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build && rm -rf .next/cache",
    "build:check": "node -e \"console.log('Checking environment variables...'); require('dotenv').config({ path: '.env.local' }); if(!process.env.NEXT_PUBLIC_SUPABASE_URL || !process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY) { console.error('❌ Missing: NEXT_PUBLIC_SUPABASE_URL and/or NEXT_PUBLIC_SUPABASE_ANON_KEY'); process.exit(1); } console.log('✅ Environment variables OK')\" && npm run build",
    "start": "next start",
    "lint": "next lint",
    "sync-slugs": "node scripts/sync-slugs.js",
    "translate": "node scripts/translate.js",
    "translate-all": "node scripts/translate.js",
    "translate-new": "node scripts/translate.js --new",
    "refine-translations": "node scripts/refine_translations.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1000.0",
    "@supabase/supabase-js": "^2.95.3",
    "axios": "^1.13.6",
    "boto3": "^0.0.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "framer-motion": "^12.34.3",
    "leancloud-realtime": "^5.0.0-rc.8",
    "leancloud-storage": "^4.15.2",
    "lucide-react": "^0.575.0",
    "next": "^14.2.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^3.5.0",
    "vconsole": "^3.15.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10",
    "postcss": "^8",
    "tailwindcss": "^3",
    "typescript": "^5",
    "youtube-transcript": "^1.3.0"
  }
}
